{
  // Lint-only project. The build's tsconfig sets rootDir to ./src and excludes
  // test/, so the check harness was type-checked by nothing but ts-node at run
  // time. This widens the net for eslint (and `npm run typecheck`) without
  // touching what `nest build` emits.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "rootDir": "."
  },
  "include": ["src/**/*.ts", "test/**/*.ts", "prisma/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
