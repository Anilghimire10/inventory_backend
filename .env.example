# PostgreSQL connection (matches docker-compose.yml)
DATABASE_URL="postgresql://inventory:inventory@localhost:5432/inventory?schema=public"
# Non-pooled connection used by `prisma migrate`. Same as DATABASE_URL unless you use a pooler (Supabase/Neon).
DIRECT_URL="postgresql://inventory:inventory@localhost:5432/inventory?schema=public"

# Auth
# REQUIRED. The app refuses to boot without it, and rejects the placeholder
# below, anything under 32 characters, and the old 'dev-secret' fallback.
# Generate one with:  openssl rand -base64 48
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="7d"

# App
PORT=3000
# Comma-separated allowed origins for CORS in production (e.g. https://app.example.com,https://admin.example.com).
# REQUIRED when NODE_ENV=production — the app refuses to boot without it there,
# because the dev fallback reflects whatever origin asks. Leave unset in dev.
# NOTE: the Capacitor mobile app origins (https://localhost, capacitor://localhost)
# are always allowed automatically — you do NOT need to list them here.
CORS_ORIGIN=

# Rate limiting (per IP). Defaults: 120 requests / 60s. Tighten for production.
# Both must be positive integers -- THROTTLE_TTL is milliseconds, not "60s" --
# and the app refuses to boot otherwise rather than silently disabling limits.
# Behind a load balancer this is only per-IP because main.ts trusts one proxy
# hop; add more hops there if you put your own proxy in front of it.
THROTTLE_TTL=60000
THROTTLE_LIMIT=120
# Max request body size (bulk product import). Default 8mb.
BODY_LIMIT=8mb

# Swagger docs at /docs. On by default outside production; set to true to
# expose them on a deployed (staging) instance as well.
# ENABLE_SWAGGER=false

# Platform super-admin (seeded by `npm run db:seed`)
PLATFORM_ADMIN_EMAIL="admin@platform.com"
PLATFORM_ADMIN_PASSWORD="admin12345"

# Email (Resend). Required for email verification + password reset to work.
# RESEND_API_KEY is your Resend API key; it is sent as `Authorization: Bearer <key>`.
# RESEND_FROM must be a verified sender on your Resend domain.
RESEND_API_KEY=
RESEND_FROM=
RESEND_FROM_NAME="Inventory Manager"
# Optional override; defaults to https://api.resend.com/emails
# RESEND_API_URL=

# Mail transport: "resend" (default) or "log".
# "log" sends nothing and writes the message to the application log — for
# local development, where Resend's sandbox rejects every recipient except
# the account owner's own address. Verification/reset codes are printed to
# the log outside production so flows can be completed without a mailbox.
# Refused at boot when NODE_ENV=production.
# MAIL_TRANSPORT=log
