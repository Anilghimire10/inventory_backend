# PostgreSQL connection (matches docker-compose.yml)
DATABASE_URL="postgresql://inventory:inventory@localhost:5432/inventory?schema=public"
# Non-pooled connection used by `prisma migrate`. Same as DATABASE_URL unless you use a pooler (Supabase/Neon).
DIRECT_URL="postgresql://inventory:inventory@localhost:5432/inventory?schema=public"

# Auth
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="7d"

# App
PORT=3000
# Comma-separated allowed origins for CORS in production (e.g. https://app.example.com,https://admin.example.com).
# Leave unset in dev to allow any origin.
# NOTE: the Capacitor mobile app origins (https://localhost, capacitor://localhost)
# are always allowed automatically — you do NOT need to list them here.
CORS_ORIGIN=

# Rate limiting (per IP). Defaults: 120 requests / 60s. Tighten for production.
THROTTLE_TTL=60000
THROTTLE_LIMIT=120
# Max request body size (bulk product import). Default 8mb.
BODY_LIMIT=8mb

# Platform super-admin (seeded by `npm run db:seed`)
PLATFORM_ADMIN_EMAIL="admin@platform.com"
PLATFORM_ADMIN_PASSWORD="admin12345"

# Email (Resend). Required for email verification + password reset to work.
# RESEND_API_KEY is your Resend API key; it is sent as `Authorization: Bearer <key>`.
# RESEND_FROM must be a verified sender on your Resend domain.
RESEND_API_KEY=
RESEND_FROM=
RESEND_FROM_NAME="Inventory Manager"
# Optional override; defaults to https://api.resend.com/emails
# RESEND_API_URL=
