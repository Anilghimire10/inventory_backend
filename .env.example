# PostgreSQL connection (matches docker-compose.yml)
DATABASE_URL="postgresql://inventory:inventory@localhost:5432/inventory?schema=public"
# In production, add `connection_limit=5` (append with & if the URL already has
# a ?query). Without it Prisma sizes its pool from the CPU count, which can eat
# a hosted pooler's whole allowance (Supabase session mode: 15 clients) and
# leave none for `migrate deploy`. The API logs a warning at boot if it's missing.
# Non-pooled connection used by `prisma migrate`. Same as DATABASE_URL unless you use a pooler (Supabase/Neon).
DIRECT_URL="postgresql://inventory:inventory@localhost:5432/inventory?schema=public"

# Auth
# REQUIRED. The app refuses to boot without it, and rejects the placeholder
# below, anything under 32 characters, and the old 'dev-secret' fallback.
# Generate one with:  openssl rand -base64 48
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="7d"

# App
PORT=3000
# Comma-separated allowed origins for CORS in production (e.g. https://app.example.com,https://admin.example.com).
# REQUIRED when NODE_ENV=production — the app refuses to boot without it there,
# because the dev fallback reflects whatever origin asks. Leave unset in dev.
# NOTE: the Capacitor mobile app origins (https://localhost, capacitor://localhost)
# are always allowed automatically — you do NOT need to list them here.
CORS_ORIGIN=

# Rate limiting (per IP). Defaults: 120 requests / 60s. Tighten for production.
# Both must be positive integers -- THROTTLE_TTL is milliseconds, not "60s" --
# and the app refuses to boot otherwise rather than silently disabling limits.
# Behind a load balancer this is only per-IP because main.ts trusts one proxy
# hop; add more hops there if you put your own proxy in front of it.
THROTTLE_TTL=60000
THROTTLE_LIMIT=120
# Max body size for POST /api/products/import (bulk product import) only.
# Every other route is capped at 1mb. Default 8mb.
BODY_LIMIT=8mb

# Swagger docs at /docs. On by default outside production; set to true to
# expose them on a deployed (staging) instance as well.
# ENABLE_SWAGGER=false

# Platform super-admin (seeded by `npm run db:seed`)
PLATFORM_ADMIN_EMAIL="admin@platform.com"
PLATFORM_ADMIN_PASSWORD="admin12345"
# Admin panel session length (shorter than shop users' JWT_EXPIRES_IN). Default 12h.
PLATFORM_JWT_EXPIRES_IN=12h
# Optional signing key for admin-panel tokens, kept apart from JWT_SECRET so a
# shop user's token can never verify as an admin one. Unset, a key is derived
# from JWT_SECRET (already separate). Set it to also protect admin tokens if
# JWT_SECRET alone leaks. Must be 32+ chars and differ from JWT_SECRET.
# Changing it signs all platform admins out once.  openssl rand -base64 48
# PLATFORM_JWT_SECRET=

# Free trial length for new signups, in days. Default 14.
TRIAL_DAYS=14
# Days a shop keeps working after its paid-until (or trial) end date, so a
# late renewal doesn't lock the till mid-shift. The admin panel still shows it
# as expired. Default 3; 0 locks it out on the end date.
SUBSCRIPTION_GRACE_DAYS=3
# Shown on the shop app's expired screen and trial banner, and in reminder
# emails, as who to contact to renew. Both optional.
SUPPORT_EMAIL=
SUPPORT_PHONE=
# The shop web app's address, for the admin panel's "View as owner", which
# opens it in a new tab. Required in production; defaults to
# http://localhost:5173 in development.
SHOP_APP_URL=
# The admin panel's address, e.g. https://admin.yourdomain.com. Optional: the
# admins' daily summary email links straight to its pages when it is set.
ADMIN_PANEL_URL=
# Optional key for encrypting admins' two-factor secrets at rest. Unset, one is
# derived from JWT_SECRET. Changing either makes existing two-factor setups
# unreadable: those admins then need another admin to reset theirs.
# TOTP_ENCRYPTION_KEY=

# Email (Resend). Required for email verification + password reset to work.
# RESEND_API_KEY is your Resend API key; it is sent as `Authorization: Bearer <key>`.
# RESEND_FROM must be a verified sender on your Resend domain.
RESEND_API_KEY=
RESEND_FROM=
RESEND_FROM_NAME="Inventory Manager"
# Optional override; defaults to https://api.resend.com/emails
# RESEND_API_URL=

# Mail transport: "resend" (default) or "log".
# "log" sends nothing and writes the message to the application log — for
# local development, where Resend's sandbox rejects every recipient except
# the account owner's own address. Verification/reset codes are printed to
# the log outside production so flows can be completed without a mailbox.
# Refused at boot when NODE_ENV=production.
# MAIL_TRANSPORT=log
# Development only: send every email to this one address instead, with the
# real recipient in the subject ("[to: owner@shop.com] Verify your email").
# Resend's test sender (onboarding@resend.dev) delivers only to your own
# Resend account's address, so set that here. Refused in production.
# MAIL_REDIRECT_TO=you@example.com

# ---- Product image storage -------------------------------------------------
# Where product images are kept. Set these and images go to a Supabase Storage
# bucket; leave them unset and they go to ./uploads on local disk.
#
# Local disk is fine on a laptop and NOT fine on Render, Fly or Heroku: those
# filesystems are ephemeral, so every deploy destroys every image uploaded
# since the previous one — silently, with the images simply 404ing afterwards.
# Falling back on disk in production is logged at error level on first upload.
#
# Create a PUBLIC bucket named `product-images` (Storage -> New bucket ->
# Public), then take the service-role key from Project Settings -> API. It is
# the service-role key, not the anon key: the API uploads on the user's behalf
# after its own role check, so it must not be subject to browser-facing RLS.
# It is a server-side secret — never expose it to the web app.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Optional; defaults to product-images
# SUPABASE_STORAGE_BUCKET=

# ---- Online payments (eSewa, Khalti, connectIPS) ---------------------------
# Owners pay for a plan (admin panel -> Settings -> Online payment plans) and
# the subscription is extended as soon as the gateway confirms it. A gateway
# with no keys here is simply not offered. *_MODE is "test" (the gateway's
# sandbox; no real money) or "live"; it defaults to live when
# NODE_ENV=production and test otherwise.
#
# eSewa sandbox: merchant code EPAYTEST, secret key 8gBm/:&EnhH.1/q, and log
# in on its page with eSewa ID 9711111111, password Nepal@123, token 123456.
ESEWA_MERCHANT_CODE=
ESEWA_SECRET_KEY=
# ESEWA_MODE=test
# Khalti: the live secret key from the Khalti merchant dashboard; for test
# mode, the one from a test merchant account at test-admin.khalti.com.
KHALTI_SECRET_KEY=
# KHALTI_MODE=test
# connectIPS (NCHL): the merchant id, app id, app name and app password NCHL
# issues, and the private key from the .pfx file it sends. Turn the .pfx into
# a PEM with:  openssl pkcs12 -in CREDITOR.pfx -nocerts -nodes -out cips.pem
# and give its path, or paste it into CONNECTIPS_PRIVATE_KEY with \n for
# line breaks. connectIPS does not take return URLs per payment: register
# these two with NCHL as the success and failure URLs:
#   <SHOP_APP_URL>/payment-return/
#   <SHOP_APP_URL>/payment-return/?cancelled=1
CONNECTIPS_MERCHANT_ID=
CONNECTIPS_APP_ID=
CONNECTIPS_APP_NAME=
CONNECTIPS_APP_PASSWORD=
CONNECTIPS_PRIVATE_KEY_FILE=
# CONNECTIPS_PRIVATE_KEY=
# CONNECTIPS_MODE=test
# The gateways send owners back to SHOP_APP_URL (or another CORS_ORIGIN, or
# the Android app), so set SHOP_APP_URL in production.
