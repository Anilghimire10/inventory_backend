# PostgreSQL connection (matches docker-compose.yml)
DATABASE_URL="postgresql://inventory:inventory@localhost:5432/inventory?schema=public"

# Auth
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="7d"

# App
PORT=3000
# Comma-separated allowed origins for CORS in production (e.g. https://app.example.com,https://admin.example.com).
# Leave unset in dev to allow any origin.
CORS_ORIGIN=

# Rate limiting (per IP). Defaults: 120 requests / 60s. Tighten for production.
THROTTLE_TTL=60000
THROTTLE_LIMIT=120
# Max request body size (bulk product import). Default 8mb.
BODY_LIMIT=8mb

# Platform super-admin (seeded by `npm run db:seed`)
PLATFORM_ADMIN_EMAIL="admin@platform.com"
PLATFORM_ADMIN_PASSWORD="admin12345"

# Email (ZeptoMail). Required for email verification + password reset to work.
# ZEPTOMAIL_TOKEN is the "Send Mail" token; it is sent as `Zoho-enczapikey <token>`.
# ZEPTOMAIL_FROM must be a verified sender on your ZeptoMail domain.
ZEPTOMAIL_TOKEN=
ZEPTOMAIL_FROM=
ZEPTOMAIL_FROM_NAME="Inventory Manager"
# Optional override; defaults to https://api.zeptomail.com/v1.1/email
# ZEPTOMAIL_API_URL=
