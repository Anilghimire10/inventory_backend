// Inventory Management — Prisma schema
// Multi-tenant: every tenant-scoped row carries `businessId`.
// A Business (tenant) has Stores, Users, Products, Sales, etc.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------- Enums ----------

// A simple descriptor for the kind of business (display only — does not gate
// features). Inventory features are the same for every business.
enum BusinessType {
  GROCERY
  PHARMACY
  RETAIL
  OTHER
}

// How the business sells — retail (to end customers) vs wholesale (bulk/B2B).
enum SalesModel {
  RETAIL
  WHOLESALE
}

// Fixed staff roles. Access is gated by role (carried in the JWT).
enum UserRole {
  OWNER
  MANAGER
  CASHIER
  STOCK_KEEPER
}

enum StockMovementType {
  PURCHASE // stock in from a purchase
  SALE // stock out from a sale
  ADJUSTMENT // manual correction
  RETURN_IN // customer return (stock back in)
  RETURN_OUT // returned to supplier (stock out)
  TRANSFER // moved between stores
}

enum AdjustmentReason {
  DAMAGE
  THEFT
  COUNT_CORRECTION
  EXPIRED
  OTHER
}

// Where one serialised unit (IMEI / serial number) currently is.
enum SerialStatus {
  IN_STOCK
  SOLD
  RETURNED_TO_SUPPLIER
}

enum PurchaseStatus {
  DRAFT
  ORDERED
  RECEIVED
  CANCELLED
}

enum SaleStatus {
  COMPLETED
  HELD
  RETURNED
  PARTIALLY_RETURNED
}

enum PaymentMethod {
  CASH
  CARD
  MOBILE
  CREDIT
  MIXED
}

// How a shop paid its subscription. Recorded by hand in the admin panel
// until online payment (Fonepay) creates these rows itself.
enum SubscriptionPaymentMethod {
  CASH
  BANK
  ESEWA
  KHALTI
  OTHER
}

// One-time email codes: account verification and password reset.
enum EmailTokenType {
  EMAIL_VERIFY
  PASSWORD_RESET
}

// Categories of in-app alerts surfaced in the notification bell.
enum NotificationType {
  LOW_STOCK
  EXPIRING
  GENERAL
}

// ---------- Tenant root ----------

// Platform-level operator (super-admin). NOT a tenant user — sees/manages
// every business. Lives outside the businessId tenancy boundary.
model PlatformAdmin {
  id                String    @id @default(cuid())
  email             String    @unique
  passwordHash      String
  name              String
  isActive          Boolean   @default(true)
  passwordChangedAt DateTime? // tokens issued before this are rejected
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  paymentsRecorded SubscriptionPayment[]
  auditLogs        PlatformAuditLog[]
}

model Business {
  id              String       @id @default(cuid())
  name            String
  type            BusinessType @default(OTHER)
  salesModel      SalesModel   @default(RETAIL)
  currency        String       @default("USD")
  /// IANA zone the shop's day is cut on -- reports, day buckets and the
  /// hour-of-day chart all key off this, not off the server's UTC clock.
  timezone        String       @default("Asia/Kathmandu")
  taxId           String? // PAN/VAT registration number
  showTaxIdOnBill Boolean      @default(false) // when on, the PAN/VAT number prints on bills
  taxInclusive    Boolean      @default(false)
  taxEnabled      Boolean      @default(true) // master switch: when off, no sale charges tax
  isSuspended     Boolean      @default(false) // suspended by a platform admin
  suspendedReason String? // shown to the business's users when sign-in is refused
  suspendedAt     DateTime?
  isSubscribed    Boolean      @default(true) // paid/active subscription (Fonepay later)
  subscribedTo    DateTime? // subscription end date; null = no expiry
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  subscriptionPayments SubscriptionPayment[]
  platformAuditLogs    PlatformAuditLog[]

  stores         Store[]
  users          User[]
  taxes          Tax[]
  categories     Category[]
  products       Product[]
  suppliers      Supplier[]
  customers      Customer[]
  purchases      Purchase[]
  sales          Sale[]
  stockItems     StockItem[]
  stockMovements StockMovement[]
  batches        Batch[]
  notifications  Notification[]
  auditLogs      AuditLog[]
  shifts         Shift[]
  serials        Serial[]
}

model Store {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name       String
  address    String?
  phone      String?
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  users          User[]
  stockItems     StockItem[]
  stockMovements StockMovement[]
  purchases      Purchase[]
  sales          Sale[]
  batches        Batch[]
  shifts         Shift[]
  serials        Serial[]

  @@index([businessId])
}

// ---------- Identity ----------

model User {
  id            String   @id @default(cuid())
  businessId    String
  business      Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  storeId       String? // default store for this user (optional)
  store         Store?   @relation(fields: [storeId], references: [id])
  email         String   @unique // globally unique -> simple login
  passwordHash  String
  name          String
  role          UserRole @default(CASHIER)
  isActive      Boolean  @default(true)
  emailVerified Boolean  @default(false)
  // Bumped whenever the password changes. Access tokens carry the value they
  // were minted with, so raising it invalidates every token issued before —
  // without it, a stolen token outlived the reset meant to kill it by up to
  // JWT_EXPIRES_IN (7 days).
  tokenVersion  Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  sales          Sale[]
  stockMovements StockMovement[]
  emailTokens    EmailToken[]
  auditLogs      AuditLog[]
  shifts         Shift[]

  @@index([businessId])
}

// Short-lived one-time codes emailed to a user (verify / reset).
model EmailToken {
  id         String         @id @default(cuid())
  userId     String
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  type       EmailTokenType
  codeHash   String // sha256 of the emailed code — never store it in the clear
  expiresAt  DateTime
  consumedAt DateTime?
  attempts   Int            @default(0) // wrong guesses; the code dies after MAX_CODE_ATTEMPTS
  createdAt  DateTime       @default(now())

  @@index([userId, type])
}

// ---------- Catalog ----------

model Category {
  id         String     @id @default(cuid())
  businessId String
  business   Business   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name       String
  parentId   String?
  parent     Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children   Category[] @relation("CategoryTree")
  products   Product[]  @relation("ProductCategories")
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  @@index([businessId])
}

// Admin-defined tax rates (e.g. VAT 13%). Products reference one; the rate is
// also snapshotted onto the product (and sale items) for stable calculations.
model Tax {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name       String
  rate       Decimal  @default(0) @db.Decimal(5, 2)
  isActive   Boolean  @default(true)
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  products Product[]

  @@unique([businessId, name])
  @@index([businessId])
}

model Product {
  id           String     @id @default(cuid())
  businessId   String
  business     Business   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  categories   Category[] @relation("ProductCategories")
  taxId        String?
  tax          Tax?       @relation(fields: [taxId], references: [id])
  name         String
  description  String?
  sku          String?
  barcode      String?
  brand        String?
  imageUrl     String? // path to a locally-stored image, e.g. /api/uploads/products/<file>
  expiryDate   DateTime? // product-level expiry (separate from per-batch expiry)
  unit         String     @default("pcs") // canonical set, DB CHECK Product_unit_check; kg/g/l/ml/m/ft sell fractionally, the rest whole
  costPrice    Decimal    @default(0) @db.Decimal(12, 2)
  sellingPrice Decimal    @default(0) @db.Decimal(12, 2)
  taxRate      Decimal    @default(0) @db.Decimal(5, 2)
  isTaxable    Boolean    @default(true) // when false, this product is never taxed
  isRxRequired Boolean    @default(false) // pharmacy: prescription required
  trackBatches Boolean    @default(false) // enable batch/expiry tracking
  trackSerials Boolean    @default(false) // enable per-unit serial/IMEI tracking
  reorderLevel Int        @default(0)
  isActive     Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  // Variants are products in their own right (own SKU, price, barcode, stock)
  // that point back at the style they belong to. Keeping them in this table
  // means stock/sales/purchases need no notion of a variant at all.
  parentId    String?
  parent      Product?  @relation("ProductVariants", fields: [parentId], references: [id])
  variants    Product[] @relation("ProductVariants")
  variantName String? // display label, e.g. "Red / XL"
  attributes  Json? // the options behind that label, e.g. {"Colour":"Red","Size":"XL"}

  stockItems     StockItem[]
  batches        Batch[]
  stockMovements StockMovement[]
  saleItems      SaleItem[]
  purchaseItems  PurchaseItem[]
  serials        Serial[]

  @@unique([businessId, sku])
  @@unique([businessId, barcode])
  @@index([businessId])
  @@index([parentId])
}

// ---------- Stock ----------

model StockItem {
  id           String   @id @default(cuid())
  businessId   String
  business     Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  storeId      String
  store        Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  productId    String
  product      Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity     Decimal  @default(0) @db.Decimal(12, 3) // fractional: weighed goods (kg/L)
  reorderLevel Int      @default(0) // overrides product.reorderLevel when > 0
  updatedAt    DateTime @updatedAt

  @@unique([storeId, productId])
  @@index([businessId])
  @@index([storeId])
  // Both indexes above lead with storeId, so a lookup by product alone could
  // use neither — "which stores carry this product" and the variant seeding
  // that follows a parent's stores both scan the table without this.
  @@index([productId])
}

model Batch {
  id          String    @id @default(cuid())
  businessId  String
  business    Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  storeId     String
  store       Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  productId   String
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  batchNumber String?
  expiryDate  DateTime?
  quantity    Decimal   @default(0) @db.Decimal(12, 3)
  costPrice   Decimal?  @db.Decimal(12, 2)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([businessId])
  @@index([storeId, productId])
  @@index([expiryDate])
}

model StockMovement {
  id         String            @id @default(cuid())
  businessId String
  business   Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  storeId    String
  store      Store             @relation(fields: [storeId], references: [id], onDelete: Cascade)
  productId  String
  product    Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId     String?
  user       User?             @relation(fields: [userId], references: [id])
  type       StockMovementType
  quantity   Decimal           @db.Decimal(12, 3) // positive = in, negative = out
  reason     AdjustmentReason?
  note       String?
  reference  String? // related saleId / purchaseId
  createdAt  DateTime          @default(now())

  @@index([businessId])
  @@index([storeId, productId])
  @@index([createdAt])
  @@index([businessId, createdAt])
}

// One physical unit of a serialised product (phone IMEI, appliance serial).
// Only products with trackSerials get rows here; the StockItem balance stays
// the source of truth for quantity, these rows say *which* units they are.
// Links are to the purchase/sale as a whole rather than to a line item, so
// editing a purchase (which rebuilds its line rows) never orphans a unit.
model Serial {
  id           String       @id @default(cuid())
  businessId   String
  business     Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  productId    String
  product      Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  storeId      String?
  store        Store?       @relation(fields: [storeId], references: [id], onDelete: SetNull)
  serialNumber String
  status       SerialStatus @default(IN_STOCK)
  purchaseId   String?
  purchase     Purchase?    @relation(fields: [purchaseId], references: [id], onDelete: SetNull)
  saleId       String?
  sale         Sale?        @relation(fields: [saleId], references: [id], onDelete: SetNull)
  soldAt       DateTime?
  note         String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@unique([businessId, serialNumber])
  @@index([businessId, status])
  @@index([storeId, productId, status])
  @@index([saleId])
  @@index([purchaseId])
}

// ---------- Procurement ----------

model Supplier {
  id          String   @id @default(cuid())
  businessId  String
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name        String
  contactName String?
  phone       String?
  email       String?
  address     String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  purchases Purchase[]

  @@index([businessId])
}

model Purchase {
  id         String         @id @default(cuid())
  businessId String
  business   Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  storeId    String
  store      Store          @relation(fields: [storeId], references: [id])
  supplierId String?
  supplier   Supplier?      @relation(fields: [supplierId], references: [id])
  reference  String?
  status     PurchaseStatus @default(DRAFT)
  subtotal   Decimal        @default(0) @db.Decimal(12, 2)
  tax        Decimal        @default(0) @db.Decimal(12, 2)
  total      Decimal        @default(0) @db.Decimal(12, 2)
  amountPaid Decimal        @default(0) @db.Decimal(12, 2) // paid to supplier; outstanding = total - amountPaid
  note       String?
  receivedAt DateTime?
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  items   PurchaseItem[]
  serials Serial[]

  @@index([businessId])
  @@index([storeId])
}

model PurchaseItem {
  id          String    @id @default(cuid())
  purchaseId  String
  purchase    Purchase  @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  productId   String
  product     Product   @relation(fields: [productId], references: [id])
  quantity    Decimal   @db.Decimal(12, 3)
  returnedQty Decimal   @default(0) @db.Decimal(12, 3) // sent back to the supplier
  costPrice   Decimal   @db.Decimal(12, 2)
  batchNumber String?
  expiryDate  DateTime?

  @@index([purchaseId])
}

// ---------- Customers ----------

model Customer {
  id            String   @id @default(cuid())
  businessId    String
  business      Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name          String
  phone         String?
  email         String?
  address       String?
  creditBalance Decimal  @default(0) @db.Decimal(12, 2)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  sales Sale[]

  @@index([businessId])
}

// ---------- Sales / POS ----------

model Sale {
  id              String        @id @default(cuid())
  businessId      String
  business        Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  storeId         String
  store           Store         @relation(fields: [storeId], references: [id])
  userId          String?
  user            User?         @relation(fields: [userId], references: [id])
  customerId      String?
  customer        Customer?     @relation(fields: [customerId], references: [id])
  shiftId         String? // till session this sale was rung up in
  shift           Shift?        @relation(fields: [shiftId], references: [id])
  receiptNo       String
  status          SaleStatus    @default(COMPLETED)
  subtotal        Decimal       @default(0) @db.Decimal(12, 2)
  discount        Decimal       @default(0) @db.Decimal(12, 2)
  tax             Decimal       @default(0) @db.Decimal(12, 2)
  total           Decimal       @default(0) @db.Decimal(12, 2)
  // Money handed back on returns against this sale. Revenue is
  // `total - refundedTotal`, which is why a part return no longer has to
  // exclude the whole sale from the books to avoid overstating it.
  refundedTotal   Decimal       @default(0) @db.Decimal(12, 2)
  paymentMethod   PaymentMethod @default(CASH)
  amountPaid      Decimal       @default(0) @db.Decimal(12, 2)
  prescriptionRef String? // pharmacy: prescription reference
  note            String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  items   SaleItem[]
  serials Serial[]

  @@unique([businessId, receiptNo])
  @@index([businessId])
  @@index([storeId])
  @@index([shiftId])
  @@index([createdAt])
  // Every sale list filters on businessId and sorts/ranges on createdAt;
  // the two single-column indexes above can't serve that as one lookup.
  @@index([businessId, createdAt])
}

model SaleItem {
  id          String  @id @default(cuid())
  saleId      String
  sale        Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  productId   String
  product     Product @relation(fields: [productId], references: [id])
  name        String // snapshot of product name at sale time
  quantity    Decimal @db.Decimal(12, 3)
  unitPrice   Decimal @db.Decimal(12, 2)
  unitCost    Decimal @default(0) @db.Decimal(12, 2) // snapshot of cost at sale time (for accurate profit)
  discount    Decimal @default(0) @db.Decimal(12, 2)
  taxRate     Decimal @default(0) @db.Decimal(5, 2)
  lineTotal   Decimal @db.Decimal(12, 2)
  returnedQty Decimal @default(0) @db.Decimal(12, 3)

  @@index([saleId])
}

// ---------- Till sessions ----------

// A cashier's drawer session. Sales rung up while it is open carry its
// shiftId, so closing can compare the cash the drawer *should* hold with
// what was physically counted.
model Shift {
  id           String    @id @default(cuid())
  businessId   String
  business     Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  storeId      String
  store        Store     @relation(fields: [storeId], references: [id])
  userId       String
  user         User      @relation(fields: [userId], references: [id])
  openedAt     DateTime  @default(now())
  closedAt     DateTime?
  openingFloat Decimal   @default(0) @db.Decimal(12, 2)
  countedCash  Decimal?  @db.Decimal(12, 2) // what the cashier physically counted at close
  expectedCash Decimal?  @db.Decimal(12, 2) // snapshot: float + cash in - cash refunds
  variance     Decimal?  @db.Decimal(12, 2) // counted - expected
  note         String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  sales Sale[]

  // "One open shift per user PER STORE" is enforced by a partial unique index
  // on (userId, storeId) WHERE "closedAt" IS NULL — Prisma can't express
  // partial indexes, so it lives in the migration SQL only. Per store rather
  // than per user so an owner can run a till at more than one branch at once:
  // each store reconciles its own drawer, and the sessions never mix.
  @@index([businessId, openedAt])
  @@index([userId, closedAt])
  // "Which tills are open at this branch?" -- asked on every POS load now
  // that an owner joins the cashier's drawer rather than opening a second
  // one, and by the sale path to resolve which drawer a sale lands in.
  @@index([storeId, closedAt])
}

// ---------- Notifications ----------

// In-app alerts shown in the notification bell. Auto-generated alerts
// (LOW_STOCK / EXPIRING) are reconciled from live inventory each fetch and
// carry a dedupeKey; read/dismissed state is preserved across reconciliations.
model Notification {
  id          String           @id @default(cuid())
  businessId  String
  business    Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  type        NotificationType @default(GENERAL)
  title       String
  body        String?
  link        String?
  dedupeKey   String? // stable identity for auto alerts; null for one-off notices
  readAt      DateTime?
  dismissedAt DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@unique([businessId, dedupeKey])
  @@index([businessId])
}

// ---------- Audit / activity log ----------

// One row per meaningful user action (login, create/update/delete of records).
// Written by the audit interceptor + auth service; read on the admin log page.
model AuditLog {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  userName   String? // snapshot of who acted (survives user deletion)
  action     String // e.g. "sale.create", "auth.login", "product.delete"
  entity     String? // resource type, e.g. "Sale"
  entityId   String?
  summary    String? // human-readable description
  method     String?
  path       String?
  ip         String?
  createdAt  DateTime @default(now())

  @@index([businessId, createdAt])
  @@index([userId])
}

// ---------- Platform (super-admin) ----------

// A subscription payment recorded by a platform admin. Recording one extends
// Business.subscribedTo; a business with no rows here is on its trial.
model SubscriptionPayment {
  id                String                    @id @default(cuid())
  businessId        String
  business          Business                  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  amount            Decimal                   @db.Decimal(12, 2)
  currency          String
  method            SubscriptionPaymentMethod
  reference         String? // receipt number, bank reference
  periodFrom        DateTime
  periodTo          DateTime
  note              String?
  recordedByAdminId String?
  recordedByAdmin   PlatformAdmin?            @relation(fields: [recordedByAdminId], references: [id], onDelete: SetNull)
  createdAt         DateTime                  @default(now())

  @@index([businessId, createdAt])
}

// What platform admins did. Separate from AuditLog, which belongs to one
// business and records its own users.
model PlatformAuditLog {
  id           String         @id @default(cuid())
  adminId      String?
  admin        PlatformAdmin? @relation(fields: [adminId], references: [id], onDelete: SetNull)
  adminEmail   String // snapshot, so the entry outlives the admin account
  action       String // e.g. "business.suspend", "payment.record"
  businessId   String?
  business     Business?      @relation(fields: [businessId], references: [id], onDelete: SetNull)
  targetUserId String?
  details      Json?
  ip           String?
  createdAt    DateTime       @default(now())

  @@index([createdAt])
  @@index([businessId, createdAt])
}
