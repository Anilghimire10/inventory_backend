// Inventory Management — Prisma schema
// Multi-tenant: every tenant-scoped row carries `businessId`.
// A Business (tenant) has Stores, Users, Products, Sales, etc.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Enums ----------

enum BusinessType {
  GROCERY
  PHARMACY
  RETAIL
  OTHER
}

enum UserRole {
  OWNER
  MANAGER
  CASHIER
  STOCK_KEEPER
}

enum StockMovementType {
  PURCHASE // stock in from a purchase
  SALE // stock out from a sale
  ADJUSTMENT // manual correction
  RETURN_IN // customer return (stock back in)
  RETURN_OUT // returned to supplier (stock out)
  TRANSFER // moved between stores
}

enum AdjustmentReason {
  DAMAGE
  THEFT
  COUNT_CORRECTION
  EXPIRED
  OTHER
}

enum PurchaseStatus {
  DRAFT
  ORDERED
  RECEIVED
  CANCELLED
}

enum SaleStatus {
  COMPLETED
  HELD
  RETURNED
  PARTIALLY_RETURNED
}

enum PaymentMethod {
  CASH
  CARD
  MOBILE
  CREDIT
  MIXED
}

// ---------- Tenant root ----------

// Platform-level operator (super-admin). NOT a tenant user — sees/manages
// every business. Lives outside the businessId tenancy boundary.
model PlatformAdmin {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Business {
  id           String       @id @default(cuid())
  name         String
  type         BusinessType @default(OTHER)
  currency     String       @default("USD")
  taxId        String?
  taxInclusive Boolean      @default(false)
  isSuspended  Boolean      @default(false) // suspended by a platform admin
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  stores         Store[]
  users          User[]
  categories     Category[]
  products       Product[]
  suppliers      Supplier[]
  customers      Customer[]
  purchases      Purchase[]
  sales          Sale[]
  stockItems     StockItem[]
  stockMovements StockMovement[]
  batches        Batch[]
}

model Store {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name       String
  address    String?
  phone      String?
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  users          User[]
  stockItems     StockItem[]
  stockMovements StockMovement[]
  purchases      Purchase[]
  sales          Sale[]
  batches        Batch[]

  @@index([businessId])
}

// ---------- Identity ----------

model User {
  id           String   @id @default(cuid())
  businessId   String
  business     Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  storeId      String? // default store for this user (optional)
  store        Store?   @relation(fields: [storeId], references: [id])
  email        String   @unique // globally unique -> simple login
  passwordHash String
  name         String
  role         UserRole @default(CASHIER)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  sales          Sale[]
  stockMovements StockMovement[]

  @@index([businessId])
}

// ---------- Catalog ----------

model Category {
  id         String     @id @default(cuid())
  businessId String
  business   Business   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name       String
  parentId   String?
  parent     Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children   Category[] @relation("CategoryTree")
  products   Product[]
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  @@index([businessId])
}

model Product {
  id           String    @id @default(cuid())
  businessId   String
  business     Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  categoryId   String?
  category     Category? @relation(fields: [categoryId], references: [id])
  name         String
  description  String?
  sku          String?
  barcode      String?
  brand        String?
  unit         String    @default("pcs")
  costPrice    Decimal   @default(0) @db.Decimal(12, 2)
  sellingPrice Decimal   @default(0) @db.Decimal(12, 2)
  taxRate      Decimal   @default(0) @db.Decimal(5, 2)
  isRxRequired Boolean   @default(false) // pharmacy: prescription required
  trackBatches Boolean   @default(false) // enable batch/expiry tracking
  reorderLevel Int       @default(0)
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  stockItems     StockItem[]
  batches        Batch[]
  stockMovements StockMovement[]
  saleItems      SaleItem[]
  purchaseItems  PurchaseItem[]

  @@unique([businessId, sku])
  @@unique([businessId, barcode])
  @@index([businessId])
  @@index([businessId, categoryId])
}

// ---------- Stock ----------

model StockItem {
  id           String   @id @default(cuid())
  businessId   String
  business     Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  storeId      String
  store        Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  productId    String
  product      Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity     Int      @default(0)
  reorderLevel Int      @default(0) // overrides product.reorderLevel when > 0
  updatedAt    DateTime @updatedAt

  @@unique([storeId, productId])
  @@index([businessId])
  @@index([storeId])
}

model Batch {
  id          String    @id @default(cuid())
  businessId  String
  business    Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  storeId     String
  store       Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  productId   String
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  batchNumber String?
  expiryDate  DateTime?
  quantity    Int       @default(0)
  costPrice   Decimal?  @db.Decimal(12, 2)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([businessId])
  @@index([storeId, productId])
  @@index([expiryDate])
}

model StockMovement {
  id         String            @id @default(cuid())
  businessId String
  business   Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  storeId    String
  store      Store             @relation(fields: [storeId], references: [id], onDelete: Cascade)
  productId  String
  product    Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId     String?
  user       User?             @relation(fields: [userId], references: [id])
  type       StockMovementType
  quantity   Int // positive = in, negative = out
  reason     AdjustmentReason?
  note       String?
  reference  String? // related saleId / purchaseId
  createdAt  DateTime          @default(now())

  @@index([businessId])
  @@index([storeId, productId])
  @@index([createdAt])
}

// ---------- Procurement ----------

model Supplier {
  id          String   @id @default(cuid())
  businessId  String
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name        String
  contactName String?
  phone       String?
  email       String?
  address     String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  purchases Purchase[]

  @@index([businessId])
}

model Purchase {
  id         String         @id @default(cuid())
  businessId String
  business   Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  storeId    String
  store      Store          @relation(fields: [storeId], references: [id])
  supplierId String?
  supplier   Supplier?      @relation(fields: [supplierId], references: [id])
  reference  String?
  status     PurchaseStatus @default(DRAFT)
  subtotal   Decimal        @default(0) @db.Decimal(12, 2)
  tax        Decimal        @default(0) @db.Decimal(12, 2)
  total      Decimal        @default(0) @db.Decimal(12, 2)
  note       String?
  receivedAt DateTime?
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  items PurchaseItem[]

  @@index([businessId])
  @@index([storeId])
}

model PurchaseItem {
  id          String    @id @default(cuid())
  purchaseId  String
  purchase    Purchase  @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  productId   String
  product     Product   @relation(fields: [productId], references: [id])
  quantity    Int
  costPrice   Decimal   @db.Decimal(12, 2)
  batchNumber String?
  expiryDate  DateTime?

  @@index([purchaseId])
}

// ---------- Customers ----------

model Customer {
  id            String   @id @default(cuid())
  businessId    String
  business      Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name          String
  phone         String?
  email         String?
  address       String?
  creditBalance Decimal  @default(0) @db.Decimal(12, 2)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  sales Sale[]

  @@index([businessId])
}

// ---------- Sales / POS ----------

model Sale {
  id              String        @id @default(cuid())
  businessId      String
  business        Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  storeId         String
  store           Store         @relation(fields: [storeId], references: [id])
  userId          String?
  user            User?         @relation(fields: [userId], references: [id])
  customerId      String?
  customer        Customer?     @relation(fields: [customerId], references: [id])
  receiptNo       String
  status          SaleStatus    @default(COMPLETED)
  subtotal        Decimal       @default(0) @db.Decimal(12, 2)
  discount        Decimal       @default(0) @db.Decimal(12, 2)
  tax             Decimal       @default(0) @db.Decimal(12, 2)
  total           Decimal       @default(0) @db.Decimal(12, 2)
  paymentMethod   PaymentMethod @default(CASH)
  amountPaid      Decimal       @default(0) @db.Decimal(12, 2)
  prescriptionRef String? // pharmacy: prescription reference
  note            String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  items SaleItem[]

  @@unique([businessId, receiptNo])
  @@index([businessId])
  @@index([storeId])
  @@index([createdAt])
}

model SaleItem {
  id          String   @id @default(cuid())
  saleId      String
  sale        Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  productId   String
  product     Product  @relation(fields: [productId], references: [id])
  name        String // snapshot of product name at sale time
  quantity    Int
  unitPrice   Decimal  @db.Decimal(12, 2)
  unitCost    Decimal  @default(0) @db.Decimal(12, 2) // snapshot of cost at sale time (for accurate profit)
  discount    Decimal  @default(0) @db.Decimal(12, 2)
  taxRate     Decimal  @default(0) @db.Decimal(5, 2)
  lineTotal   Decimal  @db.Decimal(12, 2)
  returnedQty Int      @default(0)

  @@index([saleId])
}
