// Inventory Management — Prisma schema
// Multi-tenant: every tenant-scoped row carries `businessId`.
// A Business (tenant) has Stores, Users, Products, Sales, etc.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------- Enums ----------

// A simple descriptor for the kind of business (display only — does not gate
// features). Inventory features are the same for every business.
enum BusinessType {
  GROCERY
  PHARMACY
  RETAIL
  OTHER
}

// How the business sells — retail (to end customers) vs wholesale (bulk/B2B).
enum SalesModel {
  RETAIL
  WHOLESALE
}

// Fixed staff roles. Access is gated by role (carried in the JWT).
enum UserRole {
  OWNER
  MANAGER
  CASHIER
  STOCK_KEEPER
}

enum StockMovementType {
  PURCHASE // stock in from a purchase
  SALE // stock out from a sale
  ADJUSTMENT // manual correction
  RETURN_IN // customer return (stock back in)
  RETURN_OUT // returned to supplier (stock out)
  TRANSFER // moved between stores
}

enum AdjustmentReason {
  DAMAGE
  THEFT
  COUNT_CORRECTION
  EXPIRED
  OTHER
}

// Where one serialised unit (IMEI / serial number) currently is.
enum SerialStatus {
  IN_STOCK
  SOLD
  RETURNED_TO_SUPPLIER
  DAMAGED // came back from a customer unfit to sell; written off, never sold again
  LOST // gone from the shelf without a sale: stolen, missing at a count, or removed by hand
}

enum PurchaseStatus {
  DRAFT
  ORDERED
  RECEIVED
  CANCELLED
}

enum SaleStatus {
  COMPLETED
  HELD
  RETURNED
  PARTIALLY_RETURNED
}

enum PaymentMethod {
  CASH
  CARD
  MOBILE
  KHALTI
  CONNECTIPS // NCHL connectIPS: straight from the customer's bank account
  CREDIT
  MIXED
}

// What a Payment row records. The direction of the money is a property of the
// type, not of the amount: SALE, CUSTOMER_CREDIT and SUPPLIER_REFUND are cash
// in, REFUND and SUPPLIER_PAYMENT are cash out. Amounts are therefore always positive, so a
// customer statement never has to render a negative number.
enum PaymentType {
  SALE // taken at the till when a sale is rung up
  REFUND // handed back to the customer on a return
  CUSTOMER_CREDIT // customer paying down their udhaaro
  SUPPLIER_PAYMENT // paid out to a supplier against a purchase
  SUPPLIER_REFUND // what a supplier owes back after a return or a paid-down edit
}

// How a shop paid its subscription. Recorded by hand in the admin panel
// until online payment (Fonepay) creates these rows itself.
enum SubscriptionPaymentMethod {
  CASH
  BANK
  ESEWA
  KHALTI
  CONNECTIPS // NCHL connectIPS: straight from a bank account
  OTHER
}

enum PaymentClaimStatus {
  PENDING // reported by the shop, waiting for an admin
  CONFIRMED // an admin checked it and recorded the payment
  REJECTED // an admin couldn't find it; the shop is told why
  CANCELLED // the shop withdrew it
}

enum OnlinePaymentStatus {
  STARTED // sent to eSewa / Khalti; not paid yet as far as we know
  COMPLETED // the gateway says it's paid, and the payment is recorded
  FAILED // cancelled, expired, or never completed
}

// One-time email codes: account verification and password reset.
enum EmailTokenType {
  EMAIL_VERIFY
  PASSWORD_RESET
}

// Categories of in-app alerts surfaced in the notification bell.
enum NotificationType {
  LOW_STOCK
  EXPIRING
  GENERAL
}

// ---------- Tenant root ----------

// Platform-level operator (super-admin). NOT a tenant user — sees/manages
// every business. Lives outside the businessId tenancy boundary.
model PlatformAdmin {
  id                 String       @id @default(cuid())
  email              String       @unique
  passwordHash       String
  name               String
  isActive           Boolean      @default(true)
  /// ADMIN can change anything; SUPPORT reads, views as owner and answers
  /// support tickets (see PlatformAuthGuard).
  role               PlatformRole @default(ADMIN)
  passwordChangedAt  DateTime? // tokens issued before this are rejected
  /// Two-factor sign-in (TOTP). The secret is AES-GCM encrypted (common/totp.ts).
  /// Set but not enabled = enrolment started, not yet confirmed with a code.
  totpSecret         String?
  totpEnabledAt      DateTime?
  /// Last 30-second step a code was accepted for, so no code works twice.
  totpLastStep       Int?
  /// Wrong codes in a row; reaching the limit sets totpLockedUntil.
  totpFailedAttempts Int          @default(0)
  totpLockedUntil    DateTime?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  paymentsRecorded SubscriptionPayment[]
  auditLogs        PlatformAuditLog[]
  businessNotes    BusinessNote[]
  supportMessages  SupportMessage[]
  assignedTickets  SupportTicket[]
  sessions         AdminSession[]
  reviewedClaims   PaymentClaim[]
}

model Business {
  id                    String          @id @default(cuid())
  name                  String
  type                  BusinessType    @default(OTHER)
  salesModel            SalesModel      @default(RETAIL)
  currency              String          @default("USD")
  /// IANA zone the shop's day is cut on -- reports, day buckets and the
  /// hour-of-day chart all key off this, not off the server's UTC clock.
  timezone              String          @default("Asia/Kathmandu")
  taxId                 String? // PAN/VAT registration number
  showTaxIdOnBill       Boolean         @default(false) // when on, the PAN/VAT number prints on bills
  taxInclusive          Boolean         @default(false) // selling prices include tax (backed out at sale time)
  taxEnabled            Boolean         @default(true) // master switch: when off, no sale charges tax
  /// Cashiers count the drawer without being shown what it should hold, and
  /// never see the variance. Owners and managers always see both.
  shiftBlindClose       Boolean         @default(false)
  /// A drawer off by more than this can't be closed without a note saying
  /// why. Null: a note is never required.
  shiftVarianceNoteOver Decimal?        @db.Decimal(12, 2)
  /// The tenders this shop takes, chosen by the owner in Settings: the POS,
  /// khata, supplier and refund pickers offer only these. Cash is always in.
  acceptedTenders       PaymentMethod[] @default([CASH, CARD, MOBILE])
  /// The subscription plan the shop is on (an id from PlatformSettings.plans):
  /// set when a payment for it goes through, or by an admin. Its branch limit
  /// is enforced; null (a trial, or a plan since deleted) has no limit.
  planId                String?
  isSuspended           Boolean         @default(false) // suspended by a platform admin
  suspendedReason       String? // shown to the business's users when sign-in is refused
  suspendedAt           DateTime?
  isSubscribed          Boolean         @default(true) // paid/active subscription (Fonepay later)
  subscribedTo          DateTime? // subscription end date; null = no expiry
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  subscriptionPayments SubscriptionPayment[]
  platformAuditLogs    PlatformAuditLog[]
  adminNotes           BusinessNote[]
  emailLogs            EmailLog[]

  stores         Store[]
  users          User[]
  taxes          Tax[]
  categories     Category[]
  products       Product[]
  suppliers      Supplier[]
  customers      Customer[]
  purchases      Purchase[]
  sales          Sale[]
  stockItems     StockItem[]
  stockMovements StockMovement[]
  batches        Batch[]
  notifications  Notification[]
  auditLogs      AuditLog[]
  supportTickets SupportTicket[]
  shifts         Shift[]
  cashMovements  CashMovement[]
  payments       Payment[]
  serials        Serial[]
  paymentClaims  PaymentClaim[]
  onlinePayments OnlinePayment[]
}

model Store {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name       String
  address    String?
  phone      String?
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  users          User[]
  stockItems     StockItem[]
  stockMovements StockMovement[]
  purchases      Purchase[]
  sales          Sale[]
  batches        Batch[]
  shifts         Shift[]
  payments       Payment[]
  serials        Serial[]

  @@index([businessId])
}

// ---------- Identity ----------

model User {
  id            String   @id @default(cuid())
  businessId    String
  business      Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  storeId       String? // default store for this user (optional)
  store         Store?   @relation(fields: [storeId], references: [id])
  email         String   @unique // globally unique -> simple login
  passwordHash  String
  name          String
  role          UserRole @default(CASHIER)
  isActive      Boolean  @default(true)
  emailVerified Boolean  @default(false)
  // Bumped whenever the password changes. Access tokens carry the value they
  // were minted with, so raising it invalidates every token issued before —
  // without it, a stolen token outlived the reset meant to kill it by up to
  // JWT_EXPIRES_IN (7 days).
  tokenVersion  Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  sales                Sale[]
  stockMovements       StockMovement[]
  emailTokens          EmailToken[]
  auditLogs            AuditLog[]
  supportTickets       SupportTicket[]
  payments             Payment[]
  shifts               Shift[]
  cashMovements        CashMovement[]
  notificationReceipts NotificationReceipt[]
  notifications        Notification[]

  paymentClaims  PaymentClaim[]
  onlinePayments OnlinePayment[]

  @@index([businessId])
}

// Short-lived one-time codes emailed to a user (verify / reset).
model EmailToken {
  id         String         @id @default(cuid())
  userId     String
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  type       EmailTokenType
  codeHash   String // sha256 of the emailed code — never store it in the clear
  expiresAt  DateTime
  consumedAt DateTime?
  attempts   Int            @default(0) // wrong guesses; the code dies after MAX_CODE_ATTEMPTS
  createdAt  DateTime       @default(now())

  @@index([userId, type])
}

// ---------- Catalog ----------

model Category {
  id         String     @id @default(cuid())
  businessId String
  business   Business   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name       String
  parentId   String?
  parent     Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children   Category[] @relation("CategoryTree")
  products   Product[]  @relation("ProductCategories")
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  @@index([businessId])
}

// Admin-defined tax rates (e.g. VAT 13%). Products reference one; the rate is
// also snapshotted onto the product (and sale items) for stable calculations.
model Tax {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name       String
  rate       Decimal  @default(0) @db.Decimal(5, 2)
  isActive   Boolean  @default(true)
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  products Product[]

  @@unique([businessId, name])
  @@index([businessId])
}

model Product {
  id           String     @id @default(cuid())
  businessId   String
  business     Business   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  categories   Category[] @relation("ProductCategories")
  taxId        String?
  tax          Tax?       @relation(fields: [taxId], references: [id])
  name         String
  description  String?
  sku          String?
  barcode      String?
  brand        String?
  imageUrl     String? // path to a locally-stored image, e.g. /api/uploads/products/<file>
  expiryDate   DateTime? // product-level expiry (separate from per-batch expiry)
  unit         String     @default("pcs") // canonical set, DB CHECK Product_unit_check; kg/g/l/ml/m/ft sell fractionally, the rest whole
  costPrice    Decimal    @default(0) @db.Decimal(12, 2)
  sellingPrice Decimal    @default(0) @db.Decimal(12, 2)
  taxRate      Decimal    @default(0) @db.Decimal(5, 2)
  isTaxable    Boolean    @default(true) // when false, this product is never taxed
  isRxRequired Boolean    @default(false) // pharmacy: prescription required
  trackBatches Boolean    @default(false) // enable batch/expiry tracking
  trackSerials Boolean    @default(false) // enable per-unit serial/IMEI tracking
  reorderLevel Int        @default(0)
  isActive     Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  // Variants are products in their own right (own SKU, price, barcode, stock)
  // that point back at the style they belong to. Keeping them in this table
  // means stock/sales/purchases need no notion of a variant at all.
  parentId    String?
  parent      Product?  @relation("ProductVariants", fields: [parentId], references: [id])
  variants    Product[] @relation("ProductVariants")
  variantName String? // display label, e.g. "Red / XL"
  attributes  Json? // the options behind that label, e.g. {"Colour":"Red","Size":"XL"}

  stockItems     StockItem[]
  batches        Batch[]
  stockMovements StockMovement[]
  saleItems      SaleItem[]
  purchaseItems  PurchaseItem[]
  serials        Serial[]

  @@unique([businessId, sku])
  @@unique([businessId, barcode])
  @@index([businessId])
  @@index([parentId])
}

// ---------- Stock ----------

model StockItem {
  id           String   @id @default(cuid())
  businessId   String
  business     Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  storeId      String
  store        Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  productId    String
  product      Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity     Decimal  @default(0) @db.Decimal(12, 3) // fractional: weighed goods (kg/L)
  reorderLevel Int      @default(0) // overrides product.reorderLevel when > 0
  /// Clearance price for stock nearing its date, for a product that keeps one
  /// expiry date on itself rather than batches. Only applies while the
  /// product's expiry is still `clearanceFor`: stock that arrives with a new
  /// date isn't marked down with the old.
  clearancePrice Decimal?  @db.Decimal(12, 2)
  clearanceFor   DateTime?
  updatedAt    DateTime @updatedAt

  @@unique([storeId, productId])
  @@index([businessId])
  @@index([storeId])
  // Both indexes above lead with storeId, so a lookup by product alone could
  // use neither — "which stores carry this product" and the variant seeding
  // that follows a parent's stores both scan the table without this.
  @@index([productId])
}

model Batch {
  id          String    @id @default(cuid())
  businessId  String
  business    Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  storeId     String
  store       Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  productId   String
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  batchNumber String?
  expiryDate  DateTime?
  quantity    Decimal   @default(0) @db.Decimal(12, 3)
  costPrice   Decimal?  @db.Decimal(12, 2)
  /// Marked down to sell before it expires. The till prices units drawn from
  /// this batch at this while it is in date.
  clearancePrice Decimal? @db.Decimal(12, 2)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  saleItems   SaleItemBatch[]

  @@index([businessId])
  @@index([storeId, productId])
  @@index([expiryDate])
}

model StockMovement {
  id         String            @id @default(cuid())
  businessId String
  business   Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  storeId    String
  store      Store             @relation(fields: [storeId], references: [id], onDelete: Cascade)
  productId  String
  product    Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId     String?
  user       User?             @relation(fields: [userId], references: [id])
  type       StockMovementType
  quantity   Decimal           @db.Decimal(12, 3) // positive = in, negative = out
  reason     AdjustmentReason?
  note       String?
  reference  String? // related saleId / purchaseId
  createdAt  DateTime          @default(now())

  @@index([businessId])
  @@index([storeId, productId])
  @@index([createdAt])
  @@index([businessId, createdAt])
}

// One physical unit of a serialised product (phone IMEI, appliance serial).
// Only products with trackSerials get rows here; the StockItem balance stays
// the source of truth for quantity, these rows say *which* units they are.
// Links are to the purchase/sale as a whole rather than to a line item, so
// editing a purchase (which rebuilds its line rows) never orphans a unit.
model Serial {
  id           String       @id @default(cuid())
  businessId   String
  business     Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  productId    String
  product      Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  storeId      String?
  store        Store?       @relation(fields: [storeId], references: [id], onDelete: SetNull)
  serialNumber String
  status       SerialStatus @default(IN_STOCK)
  purchaseId   String?
  purchase     Purchase?    @relation(fields: [purchaseId], references: [id], onDelete: SetNull)
  saleId       String?
  sale         Sale?        @relation(fields: [saleId], references: [id], onDelete: SetNull)
  soldAt       DateTime?
  note         String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@unique([businessId, serialNumber])
  @@index([businessId, status])
  @@index([storeId, productId, status])
  @@index([saleId])
  @@index([purchaseId])
}

// ---------- Procurement ----------

model Supplier {
  id          String   @id @default(cuid())
  businessId  String
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name        String
  contactName String?
  phone       String?
  email       String?
  address     String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  payments  Payment[]
  purchases Purchase[]

  @@index([businessId])
}

model Purchase {
  id         String         @id @default(cuid())
  businessId String
  business   Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  storeId    String
  store      Store          @relation(fields: [storeId], references: [id])
  supplierId String?
  supplier   Supplier?      @relation(fields: [supplierId], references: [id])
  reference  String?
  status     PurchaseStatus @default(DRAFT)
  subtotal   Decimal        @default(0) @db.Decimal(12, 2)
  tax        Decimal        @default(0) @db.Decimal(12, 2)
  total      Decimal        @default(0) @db.Decimal(12, 2)
  amountPaid Decimal        @default(0) @db.Decimal(12, 2) // paid to supplier; outstanding = total - amountPaid
  /// What the supplier owes back: money already paid that a return (or an
  /// edit that shrank the invoice) no longer covers. Cleared by recording the
  /// refund when it actually arrives, which is when the ledger gets its row.
  refundDue  Decimal        @default(0) @db.Decimal(12, 2)
  note       String?
  receivedAt DateTime?
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  items    PurchaseItem[]
  payments Payment[]
  serials  Serial[]

  @@index([businessId])
  @@index([storeId])
}

model PurchaseItem {
  id          String    @id @default(cuid())
  purchaseId  String
  purchase    Purchase  @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  productId   String
  product     Product   @relation(fields: [productId], references: [id])
  quantity    Decimal   @db.Decimal(12, 3)
  returnedQty Decimal   @default(0) @db.Decimal(12, 3) // sent back to the supplier
  costPrice   Decimal   @db.Decimal(12, 2) // before VAT
  taxRate     Decimal   @default(0) @db.Decimal(5, 2) // VAT the supplier charged on this line (input VAT)
  batchNumber String?
  expiryDate  DateTime?

  @@index([purchaseId])
}

// ---------- Customers ----------

model Customer {
  id            String   @id @default(cuid())
  businessId    String
  business      Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name          String
  phone         String?
  email         String?
  address       String?
  creditBalance Decimal  @default(0) @db.Decimal(12, 2)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  payments Payment[]
  sales    Sale[]

  @@index([businessId])
}

// ---------- Sales / POS ----------

model Sale {
  id              String        @id @default(cuid())
  businessId      String
  business        Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  storeId         String
  store           Store         @relation(fields: [storeId], references: [id])
  userId          String?
  user            User?         @relation(fields: [userId], references: [id])
  customerId      String?
  customer        Customer?     @relation(fields: [customerId], references: [id])
  shiftId         String? // till session this sale was rung up in
  shift           Shift?        @relation(fields: [shiftId], references: [id])
  receiptNo       String
  status          SaleStatus    @default(COMPLETED)
  subtotal        Decimal       @default(0) @db.Decimal(12, 2)
  discount        Decimal       @default(0) @db.Decimal(12, 2)
  tax             Decimal       @default(0) @db.Decimal(12, 2)
  total           Decimal       @default(0) @db.Decimal(12, 2)
  // Snapshot of Business.taxInclusive when the sale was priced. When true,
  // each line's unitPrice already contains its tax, so net is backed out of
  // it rather than tax being added on top. Snapshotted so flipping the
  // setting never re-reads old sales.
  taxInclusive    Boolean       @default(false)
  // Money handed back on returns against this sale. Revenue is
  // `total - refundedTotal`, which is why a part return no longer has to
  // exclude the whole sale from the books to avoid overstating it.
  refundedTotal   Decimal       @default(0) @db.Decimal(12, 2)
  paymentMethod   PaymentMethod @default(CASH)
  amountPaid      Decimal       @default(0) @db.Decimal(12, 2)
  prescriptionRef String? // pharmacy: prescription reference
  note            String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  items    SaleItem[]
  payments Payment[]
  serials  Serial[]

  @@unique([businessId, receiptNo])
  @@index([businessId])
  @@index([storeId])
  @@index([shiftId])
  @@index([createdAt])
  // Every sale list filters on businessId and sorts/ranges on createdAt;
  // the two single-column indexes above can't serve that as one lookup.
  @@index([businessId, createdAt])
}

model SaleItem {
  id          String  @id @default(cuid())
  saleId      String
  sale        Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  productId   String
  product     Product @relation(fields: [productId], references: [id])
  name        String // snapshot of product name at sale time
  quantity    Decimal @db.Decimal(12, 3)
  unitPrice   Decimal @db.Decimal(12, 2)
  unitCost    Decimal @default(0) @db.Decimal(12, 2) // snapshot of cost at sale time (for accurate profit)
  discount    Decimal @default(0) @db.Decimal(12, 2)
  taxRate     Decimal @default(0) @db.Decimal(5, 2)
  lineTotal   Decimal @db.Decimal(12, 2)
  returnedQty Decimal @default(0) @db.Decimal(12, 3)
  batches     SaleItemBatch[]

  @@index([saleId])
}

/// Which batch the units of a sale line came out of.
///
/// A sale draws batches down first-expiry-first, and a return used to guess
/// where its units went back -- sometimes into a batch that had already
/// expired, so a good unit was later written off with it. With this, a
/// return puts each unit back into the batch it was sold from.
model SaleItemBatch {
  id          String   @id @default(cuid())
  saleItemId  String
  saleItem    SaleItem @relation(fields: [saleItemId], references: [id], onDelete: Cascade)
  batchId     String
  batch       Batch    @relation(fields: [batchId], references: [id], onDelete: Cascade)
  quantity    Decimal  @db.Decimal(12, 3)
  /// Units of this allocation already returned, damaged or not.
  returnedQty Decimal  @default(0) @db.Decimal(12, 3)

  @@index([saleItemId])
  @@index([batchId])
}

// ---------- Till sessions ----------

// A cashier's drawer session. Sales rung up while it is open carry its
// shiftId, so closing can compare the cash the drawer *should* hold with
// what was physically counted.
model Shift {
  id             String    @id @default(cuid())
  businessId     String
  business       Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  storeId        String
  store          Store     @relation(fields: [storeId], references: [id])
  userId         String
  user           User      @relation(fields: [userId], references: [id])
  openedAt       DateTime  @default(now())
  closedAt       DateTime?
  openingFloat   Decimal   @default(0) @db.Decimal(12, 2)
  countedCash    Decimal?  @db.Decimal(12, 2) // what the cashier physically counted at close
  expectedCash   Decimal?  @db.Decimal(12, 2) // snapshot: float + cash in - cash refunds
  variance       Decimal?  @db.Decimal(12, 2) // counted - expected
  /// Snapshot at close of what had been handed back against this shift's
  /// sales, so a return made later can't rewrite a Z report already counted.
  refundsAtClose Decimal?  @db.Decimal(12, 2)
  /// What the previous shift at this store said it left in the drawer, read
  /// when this one opened. `openingFloat - carriedFloat` is cash that went
  /// missing (or appeared) between two counts, before this cashier touched it.
  carriedFloat   Decimal?  @db.Decimal(12, 2)
  /// Of the cash counted at close, what stays in the drawer as the next
  /// shift's float. The rest (`countedCash - cashLeft`) was taken away.
  cashLeft       Decimal?  @db.Decimal(12, 2)
  /// Notes and coins counted at close, `{ "500": 3, "100": 7 }`, when the
  /// cashier counted by denomination rather than typing a total.
  cashCount      Json?
  note           String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  sales         Sale[]
  payments      Payment[]
  cashMovements CashMovement[]

  // "One open shift per user PER STORE" is enforced by a partial unique index
  // on (userId, storeId) WHERE "closedAt" IS NULL — Prisma can't express
  // partial indexes, so it lives in the migration SQL only. Per store rather
  // than per user so an owner can run a till at more than one branch at once:
  // each store reconciles its own drawer, and the sessions never mix.
  @@index([businessId, openedAt])
  @@index([userId, closedAt])
  // "Which tills are open at this branch?" -- asked on every POS load now
  // that an owner joins the cashier's drawer rather than opening a second
  // one, and by the sale path to resolve which drawer a sale lands in.
  @@index([storeId, closedAt])
}

/// Which way cash crossed the drawer outside a sale, refund or credit payment.
enum CashMovementType {
  PAY_IN // cash put into the drawer
  PAY_OUT // cash taken out of it
}

/// Why. Fixed codes rather than free text so a report can total them.
enum CashMovementReason {
  FLOAT_TOPUP // more change added to the drawer (pay in)
  EXPENSE // a small shop expense paid from the till: tea, milk, transport
  SUPPLIER // a supplier paid in cash from the till
  SAFE_DROP // excess cash moved to the safe or the bank
  OWNER_DRAW // the owner took cash for themselves
  OTHER // anything else -- a note is then required
}

/// Cash put into or taken out of a drawer while a shift is open.
///
/// Without these, every rupee paid out of the till for tea or a supplier
/// showed up at close as the cashier being short. Rows are never edited or
/// deleted: a mistake is corrected with an opposite movement, so the Z report
/// can always be explained line by line. They can't be added once the shift
/// is closed either -- the counted drawer is final.
///
/// A SUPPLIER pay out only records cash leaving the drawer. What the shop
/// owes that supplier is settled on the purchase, as before.
model CashMovement {
  id         String             @id @default(cuid())
  businessId String
  business   Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  shiftId    String
  shift      Shift              @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  userId     String
  user       User               @relation(fields: [userId], references: [id])
  type       CashMovementType
  reason     CashMovementReason
  amount     Decimal            @db.Decimal(12, 2)
  note       String?
  createdAt  DateTime           @default(now())

  @@index([shiftId, createdAt])
  @@index([businessId, createdAt])
}

// ---------- Money ----------

/// Every movement of money, as it happens.
///
/// Before this existed, paying down a customer's udhaaro or settling a
/// supplier invoice only moved a balance: `Customer.creditBalance` went down,
/// `Purchase.amountPaid` went up, and nothing recorded who paid, when, or by
/// what means. A customer asking "when did I pay that 5,000?" could not be
/// answered, and cash collected against credit at the till never reached the
/// shift's expected cash, so the drawer could not be made to balance.
///
/// Balances stay where they are rather than becoming derived: they are read on
/// hot paths and guarded by atomic statements that this ledger does not
/// replace. What changes is that every write to one is now accompanied by a
/// row here, in the same transaction, so the two can always be reconciled.
model Payment {
  id         String        @id @default(cuid())
  businessId String
  business   Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  /// Where the money changed hands. Null for payments not made at a till.
  storeId    String?
  store      Store?        @relation(fields: [storeId], references: [id])
  type       PaymentType
  /// Always positive — what physically changed hands. See PaymentType for
  /// which direction each type moves.
  amount     Decimal       @db.Decimal(12, 2)
  method     PaymentMethod

  /// Whichever of these the payment concerns; the rest are null.
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id])
  supplierId String?
  supplier   Supplier? @relation(fields: [supplierId], references: [id])
  saleId     String?
  sale       Sale?     @relation(fields: [saleId], references: [id])
  purchaseId String?
  purchase   Purchase? @relation(fields: [purchaseId], references: [id])

  /// The till session this passed through, when it passed through one. This
  /// is what lets a Z report account for credit collected at the counter.
  shiftId String?
  shift   Shift?  @relation(fields: [shiftId], references: [id])
  /// Who took or made the payment. Null only for rows with no acting user.
  userId  String?
  user    User?   @relation(fields: [userId], references: [id])

  note      String?
  createdAt DateTime @default(now())

  @@index([businessId, createdAt])
  /// Customer and supplier statements: every row for one party, in order.
  @@index([customerId, createdAt])
  @@index([supplierId, createdAt])
  /// Drawer reconciliation reads every payment on one shift.
  @@index([shiftId])
}

// ---------- Notifications ----------

// In-app alerts shown in the notification bell. Auto-generated alerts
// (LOW_STOCK / EXPIRING) are reconciled from live inventory each fetch and
// carry a dedupeKey; read/dismissed state is preserved across reconciliations.
model Notification {
  id             String           @id @default(cuid())
  businessId     String
  business       Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  type           NotificationType @default(GENERAL)
  title          String
  body           String?
  link           String?
  /// Set when the notice is for one person only (a reply to their support
  /// ticket). Null: everyone in the business sees it.
  userId         String?
  user           User?            @relation(fields: [userId], references: [id], onDelete: Cascade)
  dedupeKey      String? // stable identity for auto alerts; null for one-off notices
  /// The platform announcement this came from, for its "seen by" count.
  announcementId String?
  announcement   Announcement?    @relation(fields: [announcementId], references: [id], onDelete: SetNull)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  /// Who has read or dismissed it. Per person, not per shop: a notice goes to
  /// the whole business, but a cashier opening the bell must not mark it read
  /// for the owner, nor dismiss it for everyone.
  receipts NotificationReceipt[]

  @@unique([businessId, dedupeKey])
  @@index([businessId])
  @@index([announcementId])
  @@index([userId])
}

/// A message from the platform to shops' notification bells, sent now or
/// at `scheduledFor`. Who it reached is fixed when it goes out: the audience
/// is resolved at send time, so a scheduled "all trial shops" includes
/// shops that started a trial after it was written.
model Announcement {
  id             String         @id @default(cuid())
  title          String
  body           String
  /// all | selected | trial | active | expiring | expired
  audience       String
  /// For audience = selected.
  businessIds    String[]
  email          Boolean        @default(false)
  createdByEmail String
  createdAt      DateTime       @default(now())
  /// Null: sent as soon as it was written.
  scheduledFor   DateTime?
  /// When it went out. Set first as a claim, so two servers can't both send it.
  sentAt         DateTime?
  cancelledAt    DateTime?
  /// Filled in once sent.
  businesses     Int?
  emailed        Int?
  failed         Int?
  notifications  Notification[]

  @@index([scheduledFor, sentAt])
  @@index([createdAt])
}

/// One user's state for one notification. No row means unread and showing.
model NotificationReceipt {
  id             String       @id @default(cuid())
  notificationId String
  notification   Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  readAt         DateTime?
  dismissedAt    DateTime?

  @@unique([notificationId, userId])
  @@index([userId])
}

// ---------- Audit / activity log ----------

// One row per meaningful user action (login, create/update/delete of records).
// Written by the audit interceptor + auth service; read on the admin log page.
model AuditLog {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  userName   String? // snapshot of who acted (survives user deletion)
  action     String // e.g. "sale.create", "auth.login", "product.delete"
  entity     String? // resource type, e.g. "Sale"
  entityId   String?
  summary    String? // human-readable description
  method     String?
  path       String?
  ip         String?
  createdAt  DateTime @default(now())

  @@index([businessId, createdAt])
  @@index([userId])
  // Retention deletes by age across every business (PlatformSettings).
  @@index([createdAt])
}

// ---------- Platform (super-admin) ----------

// A subscription payment recorded by a platform admin. Recording one extends
// Business.subscribedTo; a business with no rows here is on its trial.
/// "I've paid": a shop telling us it paid, with what an admin needs to find
/// the money -- method, transaction reference, a screenshot. Confirming it
/// records a SubscriptionPayment the usual way and extends the subscription.
/// One pending report per shop at a time.
model PaymentClaim {
  id                String                    @id @default(cuid())
  businessId        String
  business          Business                  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  /// Who reported it. SET NULL with a snapshot, so the report outlives the user.
  submittedById     String?
  submittedBy       User?                     @relation(fields: [submittedById], references: [id], onDelete: SetNull)
  submittedByName   String
  amount            Decimal                   @db.Decimal(12, 2)
  currency          String
  method            SubscriptionPaymentMethod
  /// Transaction ID, bank reference or receipt number: what to look for.
  reference         String?
  /// Months the shop says it paid for; the admin can change it on confirming.
  months            Int?
  /// The plan the shop says it paid for, and its name then.
  planId            String?
  planName          String?
  note              String?
  /// A screenshot of the payment, uploaded like a product image.
  proofUrl          String?
  status            PaymentClaimStatus        @default(PENDING)
  rejectReason      String?
  reviewedByAdminId String?
  reviewedBy        PlatformAdmin?            @relation(fields: [reviewedByAdminId], references: [id], onDelete: SetNull)
  reviewedAt        DateTime?
  /// The payment recorded when it was confirmed.
  paymentId         String?                   @unique
  payment           SubscriptionPayment?      @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt

  @@index([status, createdAt])
  @@index([businessId, createdAt])
}

model SubscriptionPayment {
  id                String                    @id @default(cuid())
  businessId        String
  business          Business                  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  amount            Decimal                   @db.Decimal(12, 2)
  currency          String
  method            SubscriptionPaymentMethod
  reference         String? // the payer's receipt or bank reference
  /// Our receipt number, printed as SUB-000042. Sequential across the whole
  /// platform, in the order payments were recorded.
  receiptNo         Int                       @unique @default(autoincrement())
  periodFrom        DateTime
  periodTo          DateTime
  /// The plan it paid for, by name as it was then (plans can be renamed).
  planName          String?
  note              String?
  recordedByAdminId String?
  recordedByAdmin   PlatformAdmin?            @relation(fields: [recordedByAdminId], references: [id], onDelete: SetNull)
  createdAt         DateTime                  @default(now())

  claim         PaymentClaim?
  onlinePayment OnlinePayment?

  @@index([businessId, createdAt])
}

/// A subscription payment made through eSewa or Khalti from the shop app.
/// Created when the owner is sent to the gateway; completed only once the
/// gateway's own status API says it is paid (never on the browser's word).
model OnlinePayment {
  id            String                    @id @default(cuid())
  businessId    String
  business      Business                  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  startedById   String?
  startedBy     User?                     @relation(fields: [startedById], references: [id], onDelete: SetNull)
  gateway       SubscriptionPaymentMethod // ESEWA, KHALTI or CONNECTIPS
  months        Int
  /// The plan being paid for; the shop moves onto it when this completes.
  planId        String?
  planName      String?
  amount        Decimal                   @db.Decimal(12, 2)
  currency      String
  status        OnlinePaymentStatus       @default(STARTED)
  /// Khalti's pidx, or the TXNID sent to connectIPS (it takes 20 characters
  /// at most, so not our id). eSewa is sent our own id as its transaction_uuid.
  gatewayRef    String?                   @unique
  /// The gateway's transaction id once paid: eSewa ref_id, Khalti transaction_id.
  transactionId String?
  failReason    String?
  /// The payment recorded when it completed.
  paymentId     String?                   @unique
  payment       SubscriptionPayment?      @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  createdAt     DateTime                  @default(now())
  completedAt   DateTime?
  updatedAt     DateTime                  @updatedAt

  @@index([status, createdAt])
  @@index([businessId, createdAt])
}

// What platform admins did. Separate from AuditLog, which belongs to one
// business and records its own users.
/// What happened to an email once the app tried to send it.
enum EmailStatus {
  SENT // accepted by Resend
  FAILED // refused by Resend, or the request never got there
  LOGGED // MAIL_TRANSPORT=log: written to the app log, nothing sent
}

/// One row per email the app tried to send, so "I never got my code" has an
/// answer: whether it went, when, and what Resend said if it didn't. The
/// message body isn't kept -- it holds one-time codes.
model EmailLog {
  id         String      @id @default(cuid())
  to         String
  /// verification, password-reset, receipt, low-stock, invite, subscription-reminder
  type       String
  subject    String
  status     EmailStatus
  error      String?
  /// Whose email it was, when known. SET NULL, so the log outlives the business.
  businessId String?
  business   Business?   @relation(fields: [businessId], references: [id], onDelete: SetNull)
  createdAt  DateTime    @default(now())

  @@index([createdAt])
  @@index([to, createdAt])
}

/// An admin's note on a business -- calls, payment promises, setup details.
/// Platform-internal: nothing in the shop app reads it.
model BusinessNote {
  id         String         @id @default(cuid())
  businessId String
  business   Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  adminId    String?
  admin      PlatformAdmin? @relation(fields: [adminId], references: [id], onDelete: SetNull)
  adminEmail String // snapshot, so the note outlives the admin account
  body       String
  createdAt  DateTime       @default(now())

  @@index([businessId, createdAt])
}

model PlatformAuditLog {
  id           String         @id @default(cuid())
  adminId      String?
  admin        PlatformAdmin? @relation(fields: [adminId], references: [id], onDelete: SetNull)
  adminEmail   String // snapshot, so the entry outlives the admin account
  action       String // e.g. "business.suspend", "payment.record"
  businessId   String?
  business     Business?      @relation(fields: [businessId], references: [id], onDelete: SetNull)
  targetUserId String?
  details      Json?
  ip           String?
  createdAt    DateTime       @default(now())

  @@index([createdAt])
  @@index([businessId, createdAt])
}

/// Who a platform admin is. See PlatformAdmin.role.
enum PlatformRole {
  ADMIN
  SUPPORT
}

enum SupportTicketStatus {
  OPEN
  CLOSED
}

/// What a ticket is about. The shop picks it when asking; an admin can
/// correct it from the inbox.
enum SupportTicketCategory {
  BILLING // subscription, payments, receipts
  PROBLEM // something isn't working
  HOW_TO // how do I ...
  FEATURE // a feature request
  OTHER
}

/// A question or feedback from a shop, answered from the admin panel.
model SupportTicket {
  id              String                @id @default(cuid())
  businessId      String
  business        Business              @relation(fields: [businessId], references: [id], onDelete: Cascade)
  /// Who raised it. SET NULL with a snapshot, so the ticket outlives the user.
  userId          String?
  user            User?                 @relation(fields: [userId], references: [id], onDelete: SetNull)
  userName        String
  userEmail       String
  subject         String
  status          SupportTicketStatus   @default(OPEN)
  category        SupportTicketCategory @default(OTHER)
  /// Bumped by every message, so both inboxes sort by the latest activity.
  lastMessageAt   DateTime              @default(now())
  /// Which admin is handling it. Internal: shops never see this.
  assignedAdminId String?
  assignedAdmin   PlatformAdmin?        @relation(fields: [assignedAdminId], references: [id], onDelete: SetNull)
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  messages SupportMessage[]

  @@index([status, lastMessageAt])
  @@index([businessId, lastMessageAt])
  @@index([assignedAdminId, status])
}

/// One signed-in admin panel session. The token carries its id, so a
/// session can be listed, and ended from anywhere, before its token expires.
model AdminSession {
  id         String        @id @default(cuid())
  adminId    String
  admin      PlatformAdmin @relation(fields: [adminId], references: [id], onDelete: Cascade)
  createdAt  DateTime      @default(now())
  /// Refreshed at most every few minutes, not on every request.
  lastSeenAt DateTime      @default(now())
  expiresAt  DateTime
  ip         String?
  userAgent  String?
  revokedAt  DateTime?

  @@index([adminId, revokedAt])
}

/// A canned answer for the support inbox. {name} and {business} are filled
/// in with the ticket's person and shop when it's used.
model SupportReplyTemplate {
  id             String   @id @default(cuid())
  title          String
  body           String
  createdByEmail String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

/// One message in a ticket's thread, from the shop or from an admin.
model SupportMessage {
  id         String         @id @default(cuid())
  ticketId   String
  ticket     SupportTicket  @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  fromAdmin  Boolean
  /// Set on admin replies. SET NULL with the email kept, like BusinessNote.
  adminId    String?
  admin      PlatformAdmin? @relation(fields: [adminId], references: [id], onDelete: SetNull)
  authorName String
  body       String
  createdAt  DateTime       @default(now())

  @@index([ticketId, createdAt])
}

/// Platform-wide settings edited from the admin panel. A single row (id 1),
/// created on first read.
model PlatformSettings {
  id                    Int      @id @default(1)
  /// Free trial for new signups, in days. Null falls back to env TRIAL_DAYS.
  trialDays             Int?
  /// When false, the public register form is closed; admins still create
  /// businesses from the panel (2C.5).
  signupOpen            Boolean  @default(true)
  /// Shown as a banner across the shop app (and its sign-in page) while set.
  maintenanceMessage    String?
  /// While on, the shop app is closed: every shop request (signing in too) is
  /// refused with 503 MAINTENANCE. The admin panel keeps working.
  maintenanceMode       Boolean  @default(false)
  /// Shop activity-log (AuditLog) entries older than this are deleted daily.
  /// Null keeps them forever.
  auditRetentionDays    Int?
  /// Who a subscription receipt says was paid: the platform's own trading
  /// name, PAN/VAT number and contact details. Blank lines are left off.
  billingName           String?
  billingTaxId          String?
  billingAddress        String?
  billingPhone          String?
  billingEmail          String?
  /// When on, an admin without two-factor can only reach their Account page
  /// (to set it up) until they do.
  requireAdminTwoFactor Boolean  @default(false)
  /// How shops pay, shown on the shop app's Subscription page: a price line
  /// ("NPR 1,500 a month · NPR 15,000 a year"), instructions, and up to six
  /// payment methods -- [{ label, details, qrUrl? }] -- e.g. eSewa with its
  /// QR code, or a bank account.
  subscriptionPrice     String?
  paymentInstructions   String?
  paymentMethods        Json?
  /// Replaced by `plans`; its prices became the "Standard" plan. Unused.
  onlinePlans           Json?
  /// The subscription plans shops choose from (admin panel -> Settings):
  /// [{ id, name, description, features[], maxStores (null: unlimited),
  ///    prices: [{ months, amount }] }], amounts in NPR.
  plans                 Json?
  /// A morning email to every full admin: payments to confirm, subscriptions
  /// ending this week, shops locked since yesterday, tickets waiting.
  adminDigestEnabled    Boolean  @default(true)
  /// The day (Nepal time, YYYY-MM-DD) it last went out. Claimed with a
  /// guarded update, so two servers can't both send it.
  adminDigestSentOn     String?
  updatedAt             DateTime @updatedAt
  updatedBy             String? // admin email snapshot
}
